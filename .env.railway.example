# ─────────────────────────────────────────────────────────────────
# Variáveis de ambiente para deploy no Railway
# Copie este arquivo e preencha os valores no painel do Railway:
# Project → Service → Variables
# ─────────────────────────────────────────────────────────────────

# Node
NODE_ENV=production

# PORT é injetado automaticamente pelo Railway — NÃO adicionar aqui

# ── OpenAI ──────────────────────────────────────────────────────
# Chave padrão da OpenAI (platform.openai.com → API keys)
OPENAI_API_KEY=sk-...

# ── Supabase ────────────────────────────────────────────────────
# Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Settings → API → anon (public)
SUPABASE_ANON_KEY=eyJ...

# Settings → API → service_role (secret) — usado para ops admin
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Settings → Database → Connection string → URI (mode: Transaction ou Session)
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:...@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# ── Stripe ──────────────────────────────────────────────────────
# Dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_live_...

# Dashboard → Developers → Webhooks → Signing secret
# Endpoint: https://SEU-DOMINIO-RAILWAY.railway.app/api/stripe/webhook
# Events: invoice.payment_succeeded, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Chromium (PDF export) ────────────────────────────────────────
# Deixar em branco — nixpacks.toml instala chromium e o servidor encontra via `which chromium`
# Se precisar override manual: CHROMIUM_PATH=/usr/bin/chromium
